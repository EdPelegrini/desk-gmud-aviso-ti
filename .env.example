# Copie para .env e preencha. O .env NUNCA vai para o Git (veja .gitignore).
# Prefixo do seu ambiente: a parte inicial do endereço (ex.: https://exemplo.desk.ms -> exemplo)
DESK_PREFIXO=
# Chave de API de INTEGRAÇÃO do ambiente e PublicKey (Painel > Cadastros > Operadores > aba API)
DESK_API_KEY=
DESK_PUBLIC_KEY=
# Chave do Maestro já criado no ambiente
DESK_MAESTRO_CHAVE=
# Invoke URL POST do Maestro (usada nos testes por script); trate como credencial
DESK_MAESTRO_INVOKE_URL=
# URL do webhook do fluxo do Teams (Workflows); trate como credencial
DESK_TEAMS_WEBHOOK_URL=
